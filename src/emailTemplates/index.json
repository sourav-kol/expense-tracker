{
    "monthlyExpense": [
        "<!DOCTYPE html>",
        "<html lang='en'>",
        "<head>",
        "<meta charset='UTF-8'>",
        "<meta name='viewport' content='width=device-width, initial-scale=1.0'>",
        "<title>Monthly Expense Report</title>",
        "<style>",
        "body {",
        "font-family: Arial, sans-serif;",
        "background-color: #f4f4f4;",
        "margin: 0;",
        "padding: 0;",
        "}",
        ".container {",
        "width: 100%;",
        "max-width: 600px;",
        "margin: 0 auto;",
        "background-color: #ffffff;",
        "padding: 20px;",
        "box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);",
        "}",
        ".header {",
        "background-color: crimson;",
        "color: white;",
        "padding: 10px 0;",
        "text-align: center;",
        "border-radius: 5px;",
        "}",
        ".content {",
        "margin: 20px 0;",
        "}",
        ".footer {",
        "text-align: center;",
        "color: #888888;",
        "font-size: 12px;",
        "margin-top: 20px;",
        "}",
        ".expense-table {",
        "width: 100%;",
        "border-collapse: collapse;",
        "}",
        ".expense-table th, .expense-table td {",
        "border: 1px solid #dddddd;",
        "text-align: left;",
        "padding: 8px;",
        "}",
        ".expense-table th {",
        "background-color: crimson;",
        "color: white;",
        "}",
        "</style>",
        "</head>",
        "<body>",
        "<div class='container'>",
        "<div class='header'>",
        "<h1>Monthly Expense Report</h1>",
        "</div>",
        "<div class='content'>",
        "<p>Sourav,</p>",
        "<p>Here is your expense report for the month of {{month}}:</p>",
        "<table class='expense-table'>",
        "<thead>",
        "<tr>",
        "<th>Title</th>",
        "<th>Category</th>",
        "<th>Amount (₹)</th>",
        "</tr>",
        "</thead>",
        "<tbody>",
        "{{elements}}",
        "</tbody>",
        "</table>",
        "<p>Total Expense: ₹ {{totalExpense}}</p>",
        "</div>",
        "<div class='footer'>",
        "<p>Thank you for using our service.</p>",
        "<p>&copy; {{year}} Expense Tracker</p>",
        "</div>",
        "</div>",
        "</body>",
        "</html>"
    ]
}